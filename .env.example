# AI試着（/try-on）で使う Google Gemini API のキー。
# Google AI Studio（https://aistudio.google.com/）で発行し、課金を有効にしてください。
# ローカルでは .env.local に、Vercel では Project Settings > Environment Variables に設定します。
GEMINI_API_KEY=

# 任意：使用する画像モデル（既定は gemini-nano-banana-2.1）
# TRYON_MODEL=gemini-nano-banana-2.1

# 任意：1日あたりの生成回数の上限（サーバーインスタンスごとの簡易制限。既定は 200）
# TRYON_DAILY_LIMIT=200
